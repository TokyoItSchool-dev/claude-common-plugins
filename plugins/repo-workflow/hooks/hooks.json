{
  "description": "repo-workflow のガード: main / develop / ロックのブランチへの push と、GitHub MCP によるそれらのブランチへの書き込みを拒否する",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre-push-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/mcp-branch-guard.sh"
          }
        ]
      }
    ]
  }
}
